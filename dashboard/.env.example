# MongoDB connection string (Reeltor's shared cluster, dedicated database
# for this service — see server-progress.md Phase 3 for the reasoning).
MAIL_PLATFORM_DB=mongodb://localhost:27017/mailhosting

# Secret used to sign the session JWT. Generate with: openssl rand -hex 32
JWT_SECRET=

# Mailcow instance this dashboard provisions domains/mailboxes against.
MAILCOW_API_HOST=https://mail-engine.reeltor.com
MAILCOW_API_KEY=
MAILCOW_HOSTNAME=mail-engine.reeltor.com
